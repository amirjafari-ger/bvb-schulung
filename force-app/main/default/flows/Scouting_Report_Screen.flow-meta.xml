<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>chKeepWatching</name>
        <choiceText>Keep Watching</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Keep Watching</stringValue>
        </value>
    </choices>
    <choices>
        <name>chNotInterested</name>
        <choiceText>Not Interested</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Not Interested</stringValue>
        </value>
    </choices>
    <choices>
        <name>chSign</name>
        <choiceText>Sign</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Sign</stringValue>
        </value>
    </choices>
    <description>BVB workshop use case 1: guided scouting report after a match (Screen Flow). Started from the player record via quick action.</description>
    <environments>Default</environments>
    <interviewLabel>Scouting Report {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Scouting Report - Screen</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Report</name>
        <label>Create Scouting Report</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>newReportId</assignRecordIdToReference>
        <connector>
            <targetReference>Screen_Done</targetReference>
        </connector>
        <inputAssignments>
            <field>MatchDate__c</field>
            <value>
                <elementReference>inMatchDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Notes__c</field>
            <value>
                <elementReference>inNotes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opponent__c</field>
            <value>
                <elementReference>inOpponent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Player__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rating__c</field>
            <value>
                <elementReference>inRating</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Recommendation__c</field>
            <value>
                <elementReference>inRecommendation</elementReference>
            </value>
        </inputAssignments>
        <object>ScoutingReport__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Player</name>
        <label>Get Player</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Match</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Player__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Screen_Assessment</name>
        <label>Assessment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_Report</targetReference>
        </connector>
        <fields>
            <name>inRating</name>
            <dataType>Number</dataType>
            <fieldText>Rating (1-5)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>0</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;Please enter a rating between 1 and 5.&lt;/p&gt;</errorMessage>
                <formulaExpression>AND({!inRating} &gt;= 1, {!inRating} &lt;= 5)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>inRecommendation</name>
            <choiceReferences>chSign</choiceReferences>
            <choiceReferences>chKeepWatching</choiceReferences>
            <choiceReferences>chNotInterested</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Recommendation</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inNotes</name>
            <fieldText>Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Done</name>
        <label>Done</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>txtDone</name>
            <fieldText>&lt;p&gt;✅ Scouting report for &lt;b&gt;{!Get_Player.Name}&lt;/b&gt; has been saved.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Match</name>
        <label>Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Screen_Assessment</targetReference>
        </connector>
        <fields>
            <name>txtHeader</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Scouting report for {!Get_Player.Name}&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inMatchDate</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>$Flow.CurrentDate</elementReference>
            </defaultValue>
            <fieldText>Match Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inOpponent</name>
            <dataType>String</dataType>
            <fieldText>Opponent</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Player</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>newReportId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
